      "palette": [
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#5e5e5e",
          "name": "Text"
        },
        {
          "slug": "primary",
          "color": "#1d2b52",
